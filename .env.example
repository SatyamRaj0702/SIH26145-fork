# Optional Appwrite application backend. The local demo works without these values.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_ALERTS_COLLECTION_ID=
APPWRITE_API_KEY=

# Frontend uses Vite's local proxy by default.
VITE_API_BASE_URL=

# Optional Appwrite client configuration for the dashboard (Vite). When the
# endpoint is left empty, the dashboard proxies /v1 to the same origin.
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_ALERTS_COLLECTION_ID=
