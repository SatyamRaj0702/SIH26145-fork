# Optional Appwrite application backend. The local demo works without these values.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_ALERTS_COLLECTION_ID=
APPWRITE_API_KEY=

# Next.js dashboard. The default API URL is suitable for local processes.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
AUTH_SECRET=replace-with-a-long-random-value
AUTH_URL=http://localhost:5173
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional local LLM explanation layer (Ollama). Defaults work for a local
# Ollama instance; set OLLAMA_URL only when it is not on the same host.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_SECONDS=45
